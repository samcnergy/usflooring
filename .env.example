# Copy to .env.local and fill in real values. Never commit .env.local.

# --- Supabase ---
# Project URL (https://<project-ref>.supabase.co)
NEXT_PUBLIC_SUPABASE_URL=
# Publishable (anon) key — safe in the browser, RLS still enforced.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Service-role key — server only. Never expose to the browser.
SUPABASE_SERVICE_ROLE_KEY=

# --- Postgres (Prisma) ---
# Pooled URL for runtime (port 6543, ?pgbouncer=true&connection_limit=1).
DATABASE_URL=
# Direct URL for migrations (port 5432). Same db, different port, no pgbouncer.
DIRECT_URL=

# --- Anthropic ---
# Get a key at https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=
