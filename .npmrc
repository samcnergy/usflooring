# Force npm to install devDependencies during builds, regardless of NODE_ENV.
# Render (and many PaaS providers) set NODE_ENV=production at build time,
# which makes npm skip devDependencies by default. Our build needs:
#   - typescript      (next build → tsc)
#   - @tailwindcss/postcss + tailwindcss (CSS compilation)
#   - @types/*        (type-checking during build)
# All of these live in devDependencies; without this file the build fails
# with a "Cannot find module" error before any output reaches the log.
include=dev
production=false
