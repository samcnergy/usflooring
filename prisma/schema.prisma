// U.S. Floor, Kitchen & Bath — Phase 1 schema (post-restructure 2026-04).
// Source of truth for the four documents (Invoice, Work Order, Daily Work Order,
// Vendor Order). The downstream documents are projections of `Order` plus its
// children; the same field is never stored twice.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// ---------- Auth & people ----------

enum Role {
  admin
  salesperson
}

model User {
  id           String   @id @default(uuid())
  email        String   @unique
  passwordHash String?
  fullName     String
  role         Role
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())

  ordersAsSalesperson Order[]    @relation("SalespersonOrders")
  auditEntries        AuditLog[] @relation("AuditActor")
}

// ---------- Lookup tables ----------

model AdvertisingSource {
  id        String   @id @default(uuid())
  name      String   @unique
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  orders    Order[]
}

// ---------- Customers ----------

model Customer {
  id           String  @id @default(uuid())
  firstName    String
  lastName     String
  addressLine1 String
  city         String
  state        String  @default("CA")
  zip          String
  phoneHome    String?
  phoneWork    String?
  phoneExt     String?
  email        String?

  shipFirstName    String?
  shipLastName     String?
  shipAddressLine1 String?
  shipCity         String?
  shipState        String?
  shipZip          String?
  shipPhone        String?

  createdAt DateTime  @default(now())
  deletedAt DateTime?

  orders Order[]
}

// ---------- Order (the single source of truth) ----------

enum OrderStatus {
  draft
  finalized
  installed
  paid
  voided
}

enum BalanceTerm {
  cash
  cod
  finance
}

enum SubfloorType {
  wood
  concrete
  softConcrete
  other
}

enum InstallMethod {
  glueDown
  nailDown
  click
  clip
  other
}

enum CarpetType {
  plush
  berber
  glueDown
  plushWP
  berberWP
}

enum PricingMode {
  itemized   // total = sum(lineItems) + tax. Lines must have unit prices.
  flatTotal  // salesperson types totalCents directly. Lines are reference-only.
}

model Order {
  id            String      @id @default(uuid())
  // Server-assigned from a Postgres SEQUENCE starting at 6515.
  invoiceNumber Int         @unique
  status        OrderStatus @default(draft)
  dateOfSale    DateTime    @default(now())

  customerId String
  customer   Customer @relation(fields: [customerId], references: [id])

  salespersonId String
  salesperson   User   @relation("SalespersonOrders", fields: [salespersonId], references: [id])

  advertisingSourceId String?
  advertisingSource   AdvertisingSource? @relation(fields: [advertisingSourceId], references: [id])

  // Pricing & money. taxPercent is the source of truth; taxCents is computed
  // server-side. Default 7.75% (Orange County, CA combined rate). Salesperson
  // can override per order.
  pricingMode   PricingMode @default(itemized)
  taxPercent    Float       @default(7.75)
  taxCents      Int         @default(0)
  depositCents  Int         @default(0)
  subtotalCents Int         @default(0)
  totalCents    Int         @default(0)
  balanceCents  Int         @default(0)

  basedOn     String? // "Square Yards" | "Square Feet" | "Total"
  remarks     String?
  balanceTerm BalanceTerm?

  // Hand-tuned override for the auto-generated Scope of Work narrative.
  // When non-null, all rendered scopes use this string verbatim instead of
  // calling generateScopeOfWork(order). Reset by clearing the column.
  scopeOverride String?

  // Job-site fields (the "margin notes" homes from real handwritten invoices)
  jobSiteAddressLine1  String?
  jobSiteCity          String?
  jobSiteState         String?
  jobSiteZip           String?
  jobSiteSameAsBilling Boolean @default(true)
  siteContactName      String?
  siteContactPhone     String?
  accessInstructions   String?
  depositInstructions  String?

  // Work-order-only fields (filled in after the invoice exists)
  availabilityDate   DateTime?
  deliveryDate       DateTime?
  installerName      String?
  installationDate   DateTime?
  orderTakenByUserId String?

  // Floor condition (work order)
  subfloorType    SubfloorType?
  installSubfloor Boolean?
  pullOldFloor    Boolean?
  oldFloorType    String?
  oldFloorSize    String?

  // Carpet-specific (work order)
  removeOldCarpetAndPad Boolean?
  removeOldTagStrip     Boolean?
  newTackStripType      String?
  hasSteps              Boolean?
  numSteps              Int?
  emptyHouse            Boolean?
  heavyFurniture        Boolean?
  heavyFurnitureType    String?

  installMethod         InstallMethod?
  specialInstructions   String?
  moldingsRemoveReplace Boolean        @default(false)

  // Children
  rooms        OrderRoom[]
  lineItems    OrderLineItem[]
  inclusions   OrderInclusion[]
  exclusions   OrderExclusion[]
  moldings     OrderMolding[]
  fixtures     OrderFixture[]
  installNotes OrderInstallNote[]
  showerSpec   OrderShower?
  tileSpec     OrderTileStone?
  removals     OrderRemoval[]
  vendorOrders VendorOrder[]

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  @@index([salespersonId, deletedAt])
  @@index([advertisingSourceId])
  @@index([status])
}

// ---------- Rooms involved (pure checklist, no pricing) ----------

enum RoomName {
  livingRoom
  diningRoom
  familyRoom
  hall
  bedroom
  closet
  entrance
  bathroom
  masterBath
  den
  kitchen
  stairs
  office
  laundry
  downstairs
  upstairs
  outside
  other
}

model OrderRoom {
  id        String   @id @default(uuid())
  orderId   String
  order     Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  room      RoomName
  quantity  Int?     // for Bedroom(s)/Bathroom(s)/Closet(s) where staff write a count; null otherwise
  notes     String?  // optional per-room note ("master only", "downstairs", etc.)
  createdAt DateTime @default(now())

  lineItems OrderLineItem[]

  @@index([orderId])
}

// ---------- Line Items (the actual money) ----------

enum LineCategory {
  cabinet
  carpet
  vinyl
  wood
  ceramic
  counterTop
  fireplace
  shower
  tile
  stone
  molding
  labor
  fixture
  other
}

enum UnitOfMeasure {
  sqft
  sqyd
  slab
  box
  piece
  linearFt
  each
  hour
  lump
}

model OrderLineItem {
  id       String @id @default(uuid())
  orderId  String
  order    Order  @relation(fields: [orderId], references: [id], onDelete: Cascade)
  position Int    // display order within the order

  category LineCategory

  brand    String?
  style    String?
  color    String?
  sizeSpec String?
  sku      String?

  quantity       Float?
  unit           UnitOfMeasure?
  unitPriceCents Int?
  lineTotalCents Int?

  // Category-specific detail fields
  carpetType        CarpetType?
  pad               String?
  lineInstallMethod InstallMethod?

  notes String?

  // Shower-specific (category = shower)
  showerWallSqft        Float?
  showerWallMaterial    String?
  showerPan             Boolean?
  showerPanMaterial     String?
  showerSoapBoxMaterial String?
  showerBench           Boolean?
  bathroomFloorSqft     Float?
  bathroomFloorMaterial String?
  showerSchluterSize    String?
  showerSchluterColor   String?
  showerGroutColor      String?
  showerTileVertical    Boolean?
  showerTileHorizontal  Boolean?

  // Wood-specific (category = wood)
  woodWhiteRisers     Boolean?
  woodMoistureBarrier Boolean?

  // Counter top-specific (category = counterTop)
  counterTopSeal      Boolean?

  // Area group link — which room this line item belongs to
  roomId String?
  room   OrderRoom? @relation(fields: [roomId], references: [id], onDelete: SetNull)

  // PHASE 2 readiness
  materialId String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([orderId, position])
  @@index([roomId])
}

// ---------- Inclusions / Exclusions (chips + custom notes) ----------

enum InclusionType {
  material
  installation
  removalAndHaulAway
  pad
  underlayment
  moveFurniture
  demo
  sandAndCement
  hotMop
  fabrication
  sinkCutOut
  fullBacksplash
  straightEdgeNosing
  delivery
  roughPlumbing
  customerProvidedVanityInstall
  customNote
}

model OrderInclusion {
  id         String        @id @default(uuid())
  orderId    String
  order      Order         @relation(fields: [orderId], references: [id], onDelete: Cascade)
  type       InclusionType
  customText String?
  createdAt  DateTime      @default(now())

  @@unique([orderId, type, customText])
}

enum ExclusionType {
  plumbing
  patchAndPaint
  electrical
  leveling
  permits
  disposal
  customNote
}

model OrderExclusion {
  id         String        @id @default(uuid())
  orderId    String
  order      Order         @relation(fields: [orderId], references: [id], onDelete: Cascade)
  type       ExclusionType
  customText String?
  createdAt  DateTime      @default(now())

  @@unique([orderId, type, customText])
}

// ---------- Installation notes (editable per category, for installer sheets) ----------

model OrderInstallNote {
  id       String       @id @default(uuid())
  orderId  String
  order    Order        @relation(fields: [orderId], references: [id], onDelete: Cascade)
  category LineCategory
  notes    String       @default("")

  @@unique([orderId, category])
}

// ---------- Other order children (unchanged) ----------

enum MoldingType {
  baseShoe
  baseboard
  rubberCover4in
  quarterRound
  endMolding
  tMolding
  reducer
  wallBase
  stairNosing
  metalStrip
  filmOnly
  filmAndFoam
  silentStep
  bullNose
}

enum RubberCoverColor {
  gold
  silver
  glue
  none
}

model OrderMolding {
  id                String            @id @default(uuid())
  orderId           String
  order             Order             @relation(fields: [orderId], references: [id], onDelete: Cascade)
  type              MoldingType
  quantity          String?
  isReplaceExisting Boolean           @default(false)
  rubberCoverColor  RubberCoverColor?
}

enum FixtureType {
  stove
  fridge
  washer
  dryer
  waterbed
  piano
  organ
  tablesChairs
  stool
  other
}

model OrderFixture {
  id      String      @id @default(uuid())
  orderId String
  order   Order       @relation(fields: [orderId], references: [id], onDelete: Cascade)
  type    FixtureType
  notes   String?
}

model OrderShower {
  id                      String  @id @default(uuid())
  orderId                 String  @unique
  order                   Order   @relation(fields: [orderId], references: [id], onDelete: Cascade)
  shower_walls_sqft       Float?
  wall_material           String?
  shower_pan              String?
  shower_pan_material     String?
  soap_box_material       String?
  bench                   String?
  bathroom_floor_sqft     Float?
  bathroom_floor_material String?
  schluter                String?
  grout_color             String?
  vertical                Boolean?
  horizontal              Boolean?
}

model OrderTileStone {
  id              String   @id @default(uuid())
  orderId         String   @unique
  order           Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  hasTile         Boolean  @default(false)
  hasMarble       Boolean  @default(false)
  hasTravertine   Boolean  @default(false)
  hasSlate        Boolean  @default(false)
  hasTumbleMarble Boolean  @default(false)
  hasBacksplash   Boolean  @default(false)
  hasFloor        Boolean  @default(false)
  hasFireplace    Boolean  @default(false)
  hasShowerTile   Boolean  @default(false)
  hasWalls        Boolean  @default(false)
  hasCounterTop   Boolean  @default(false)
  hasStone        Boolean  @default(false)
  hasSlab         Boolean  @default(false)
  wonderboard     Boolean?
  slipSheet       Boolean?
  seal            Boolean?
  groutColor      String?
}

enum RemovalType {
  tile
  glueDownCarpet
  poolTable
  stone
  stool
  bigScreenTV
  wood
  refrigerator
  piano
  vinyl
  washer
  stove
  laminate
  dryer
  other
}

model OrderRemoval {
  id      String      @id @default(uuid())
  orderId String
  order   Order       @relation(fields: [orderId], references: [id], onDelete: Cascade)
  type    RemovalType
}

// ---------- Vendor Orders ----------

enum VendorOrderStatus {
  draft
  sent
  received
  cancelled
}

model VendorOrder {
  id      String @id @default(uuid())
  orderId String
  order   Order  @relation(fields: [orderId], references: [id], onDelete: Cascade)

  vendorId String?
  vendor   Vendor? @relation(fields: [vendorId], references: [id])

  vendorName      String
  poNumber        String
  sidemark        String?
  faxEmailDate    DateTime?
  willCallDate    DateTime?
  deliveryDate    DateTime?
  deliveryAddress String?
  // JSON snapshot of OrderLineItem rows on this PO at the moment it was
  // generated, so editing the master order doesn't silently mutate a sent PO.
  // Shape: { lineItems: { category, brand, style, color, sizeSpec, sku, quantity, unit, unitPriceCents }[] }
  lineItems       Json
  status          VendorOrderStatus @default(draft)
  createdAt       DateTime          @default(now())
}

model Vendor {
  id           String        @id @default(uuid())
  name         String        @unique
  isActive     Boolean       @default(true)
  createdAt    DateTime      @default(now())
  vendorOrders VendorOrder[]
}

// ---------- Phase 2 feeder: passive, write-only in Phase 1 ----------

model MaterialSuggestion {
  id                 String         @id @default(uuid())
  // Lowercased, trimmed, single-spaced concatenation of:
  //   category + brand + style + color + sizeSpec + unit
  fingerprint        String         @unique
  category           LineCategory
  brand              String?
  style              String?
  color              String?
  sizeSpec           String?
  unit               UnitOfMeasure?
  usageCount         Int            @default(1)
  lastVendorName     String?
  lastUnitPriceCents Int?
  firstSeenAt        DateTime       @default(now())
  lastSeenAt         DateTime       @default(now())

  @@index([category, usageCount])
  @@index([brand, usageCount])
}

// ---------- Audit log ----------

model AuditLog {
  id          String   @id @default(uuid())
  actorUserId String?
  actor       User?    @relation("AuditActor", fields: [actorUserId], references: [id])
  action      String
  entityType  String
  entityId    String
  diff        Json?
  createdAt   DateTime @default(now())

  @@index([entityType, entityId])
  @@index([actorUserId])
}

// ---------- AI analysis runs ----------

model AiAnalysisRun {
  id             String   @id @default(uuid())
  requestedById  String
  rangeStart     DateTime
  rangeEnd       DateTime
  customQuestion String?
  snapshotJson   Json
  responseMd     String
  modelId        String
  inputTokens    Int?
  outputTokens   Int?
  createdAt      DateTime @default(now())
}

